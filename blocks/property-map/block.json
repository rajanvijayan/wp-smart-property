{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "estatecraft/property-map",
	"title": "Property Map",
	"category": "estatecraft",
	"icon": "location-alt",
	"description": "The property on an OpenStreetMap map.",
	"keywords": [
		"property",
		"real estate"
	],
	"textdomain": "wp-smart-property",
	"attributes": {
		"showHeading": {
			"type": "boolean",
			"default": true
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"height": {
			"type": "number",
			"default": 360
		},
		"zoom": {
			"type": "number",
			"default": 15
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "estatecraft-blocks",
	"editorStyle": [
		"estatecraft-frontend",
		"estatecraft-blocks-editor"
	],
	"usesContext": [
		"postId",
		"postType"
	]
}
