{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "estatecraft/property-video",
	"title": "Property Video and Tour",
	"category": "estatecraft",
	"icon": "video-alt3",
	"description": "The property video and virtual tour.",
	"keywords": [
		"property",
		"real estate"
	],
	"textdomain": "wp-smart-property",
	"attributes": {
		"showHeading": {
			"type": "boolean",
			"default": true
		},
		"heading": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "estatecraft-blocks",
	"editorStyle": [
		"estatecraft-frontend",
		"estatecraft-blocks-editor"
	],
	"usesContext": [
		"postId",
		"postType"
	]
}
